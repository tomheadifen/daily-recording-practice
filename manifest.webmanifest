{
  "name": "Daily Take",
  "short_name": "Daily Take",
  "description": "Record a short video of yourself every day and watch yourself improve.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#121110",
  "theme_color": "#121110",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://tomheadifen.github.io/daily-recording-practice/manifest.webmanifest"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
